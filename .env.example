# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=portfolio_user
DB_PASSWORD=portfolio_password
DB_NAME=portfolio_db

# Server
PORT=3000
NODE_ENV=development

# Supabase (server-side writes — service_role MUST stay server-side only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co/rest/v1
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Shared secret the CMS sends as x-admin-token; set this to your chosen admin password
ADMIN_API_TOKEN=choose-a-strong-token
